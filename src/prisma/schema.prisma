generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Admin {
  id           String   @id @default(uuid())
  username     String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

model Trainer {
  id              String    @id @default(uuid())
  username        String    @unique
  passwordHash    String
  role            String    @default("trainer")
  mustChangePassword Boolean  @default(false)
  createdAt       DateTime  @default(now())
  acceptedTermsAt DateTime?
  teams           Team[]
}

model Team {
  id          String    @id @default(uuid())
  trainerId   String
  trainer     Trainer   @relation(fields: [trainerId], references: [id])
  name        String
  inviteCode  String    @unique
  logoUrl     String?
  fakeDomain  String?
  createdAt   DateTime  @default(now())
  expiresAt   DateTime?
  isActive    Boolean   @default(true)
  retainUntil DateTime?
  sessions    Session[]

  @@index([trainerId])
  @@index([inviteCode])
}

model Session {
  id            String    @id @default(uuid())
  teamId        String
  team          Team      @relation(fields: [teamId], references: [id])
  anonymousId   String
  playerHandle  String?
  startedAt     DateTime  @default(now())
  completedAt   DateTime?
  phaseScores   Json      @default("{}")
  totalScore    Int?
  endingReached String?
  deviceInfo    String?   // populated by client on session create — coarse platform label only (e.g. "desktop/chrome") — never a full UA string
  seenContent   SessionSeenContent[]

  @@index([teamId])
  @@index([anonymousId])
}

model ContentPool {
  id           String   @id @default(uuid())
  type         String   // EMAIL_PRE, EMAIL_BREACH, DM_SOCIAL, DM_ADVICE, LOG, LOLBIN, WIFI
  data         Json     // The templated JSON content (e.g. {{teamName}}, {{fakeDomain}})
  qualityScore Float    @default(0)
  audited      Boolean  @default(false)
  usageCount   Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  
  seenBy       SessionSeenContent[]

  @@index([type, audited, qualityScore])
}

model SessionSeenContent {
  id        String      @id @default(uuid())
  sessionId String
  session   Session     @relation(fields: [sessionId], references: [id])
  contentId String
  content   ContentPool @relation(fields: [contentId], references: [id])

  @@unique([sessionId, contentId])
}

model SystemConfig {
  key   String @id
  value String
}
